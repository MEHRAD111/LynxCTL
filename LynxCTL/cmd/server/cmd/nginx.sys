#!/bin/bash
#LynxCTL Server->Nginx
echo "
1.Nginx Config Edit With Vim
2.Nginx Config Edit With Nano
3.Nginx Config
4.Nginx Reload
"
read -rp ">>" nginx
case "$nginx" in
1)
sudo vim /etc/nginx/nginx.conf
;;
2)
sudo nano /etc/nginx/nginx.conf
;;
3)
sudo cat /etc/nginx/nginx.conf | less
;;
4)
nginx -t reload
;;
esac